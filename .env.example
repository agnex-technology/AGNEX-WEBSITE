# ==============================================================================
# AGNEX TECHNOLOGY — ENVIRONMENT VARIABLE SPECIFICATION
# Free-Tier Production & Local Development Configuration
# Copy this file to .env.local for local overrides. NEVER commit actual secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE CLIENT RUNTIME (Vite)
# ------------------------------------------------------------------------------
# Canonical production URL (Default: https://agnextechnology.com)
VITE_SITE_URL=https://agnextechnology.com

# Google Analytics 4 Measurement ID [FREE]
# Format: G-XXXXXXXXXX (Leave blank if not using Google Analytics)
VITE_GA_MEASUREMENT_ID=

# Optional Custom API Base URL [FREE]
# Leave empty to use same-origin relative endpoints (/api/v1/consultation) on Vercel
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. OPTIONAL SERVERLESS & BACKEND EXTENSIONS
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection String [FREE TIER / OPTIONAL]
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Leave empty if leads are only tracked via serverless logs and email alerts
DATABASE_URL=

# Resend API Key for Consultation Alerts [FREE TIER: 3,000 emails/mo / OPTIONAL]
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Internal recipient email for incoming consultation inquiries [FREE / OPTIONAL]
INQUIRY_ALERT_EMAIL=contact@agnextechnology.com
