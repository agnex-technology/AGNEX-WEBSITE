PORT=5000
NODE_ENV=development
# The Pooled URL for standard queries (required for free-tier connection limits)
DATABASE_URL="postgres://user:password@<pooler-host>:<port>/db?pgbouncer=true"

# The Direct URL for running migrations
DATABASE_URL_UNPOOLED="postgres://user:password@<direct-host>:5432/db"
JWT_SECRET=super_secret_jwt_key_that_is_at_least_16_chars
MOCK_AI=true
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
